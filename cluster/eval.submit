#!/bin/bash
#SBATCH --job-name=vpt-dreamer-eval
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --nodes=1
#SBATCH --nodelist=sandiego
#SBATCH --time=300
#SBATCH --mem=32G
#SBATCH --account=cai_res
#SBATCH --partition=gpu_ia
#SBATCH --output=/cluster/home/geifab01/vpt-dreamer/cluster/logs/%j_%N_eval.out
#SBATCH --error=/cluster/home/geifab01/vpt-dreamer/cluster/logs/%j_%N_eval.err

# ── Paths ──────────────────────────────────────────────────────────────────────
ZHAW_USER="geifab01"
PROJECT_DIR="/cluster/home/${ZHAW_USER}/vpt-dreamer"
IMAGE_NAME="vpt-dreamer:v2"
IMAGE_TAR="/raid/persistent_scratch/${ZHAW_USER}/vpt-dreamer-v2.tar"

# ── Eval args (override via --export or edit here) ────────────────────────────
# Example: sbatch --export=ALL,EVAL_ARGS="--weights /workspace/models/foundation-model-1x.weights" eval.submit
EVAL_ARGS="${EVAL_ARGS:---weights /workspace/models/foundation-model-1x.weights --steps 100000 --no_video}"

# ── Ensure log dir exists ──────────────────────────────────────────────────────
mkdir -p "${PROJECT_DIR}/cluster/logs"

echo "Job ${SLURM_JOB_ID} starting on $(hostname) at $(date)"
echo "Eval args: ${EVAL_ARGS}"

# ── Load image ─────────────────────────────────────────────────────────────────
if ! podman image exists "${IMAGE_NAME}"; then
    echo "==> Loading image from ${IMAGE_TAR}"
    podman load -i "${IMAGE_TAR}"
else
    echo "==> Image ${IMAGE_NAME} already in local store"
fi

# ── Run eval ───────────────────────────────────────────────────────────────────
podman run --rm \
    -v "${PROJECT_DIR}/src:/workspace/src:ro" \
    -v "${PROJECT_DIR}/models:/workspace/models:ro" \
    -v "${PROJECT_DIR}/logs:/workspace/logs" \
    -e MINEDOJO_HEADLESS=1 \
    -e LIBGL_ALWAYS_SOFTWARE=1 \
    -e DISPLAY=:99 \
    "${IMAGE_NAME}" \
    python3 -u /workspace/src/eval.py ${EVAL_ARGS}

echo "Job ${SLURM_JOB_ID} finished at $(date)"
